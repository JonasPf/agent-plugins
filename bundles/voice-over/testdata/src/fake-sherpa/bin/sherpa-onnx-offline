#!/bin/sh
# Stands in for sherpa-onnx's offline recognizer in tests: notes how it was
# called, keeps the first sound it was given, and answers every sound with the
# tokens of "So in this case we use Blockdaemon." and their times, one JSON
# line each, as the real one does. helper-runs.txt gets a line for each run:
# how many sounds it was given.
for a; do printf '%s\n' "$a"; done > helper-args.txt
n=0
for a; do case $a in --*) ;; *) n=$((n + 1)) ;; esac; done
echo $n >> helper-runs.txt
for a; do
  case $a in
  --*) ;;
  *)
    [ -f helper-input.wav ] || cp "$a" helper-input.wav || { echo "Failed to read '$a'" >&2; exit 1; }
    echo '{"lang": "", "emotion": "", "event": "", "text": " So in this case we use Blockdaemon.", "timestamps": [0.00, 0.30, 0.60, 0.90, 2.50, 2.80, 3.10, 3.30, 3.50, 3.90], "durations": [0.20, 0.20, 0.20, 0.30, 0.20, 0.20, 0.20, 0.20, 0.30, 0.20], "tokens":[" So", " in", " this", " case", " we", " use", " Block", "da", "emon", "."], "words": []}'
    ;;
  esac
done
