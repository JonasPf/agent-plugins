#!/bin/sh
# Stands in for sherpa-onnx's program in tests: notes how it was called,
# keeps the sound it was given, and says two phrases the way the real one
# does, on stdout, with its own notes on stderr.
for a; do printf '%s\n' "$a"; done > helper-args.txt
for a; do last=$a; done
cp "$last" helper-input.wav || { echo "Failed to read '$last'" >&2; exit 1; }
echo "Started!" >&2
echo "0.000 -- 2.500: So in this case"
echo "2.500 -- 4.100: we use Blockdaemon."
echo "Real time factor (RTF): 0.100 / 4.100 = 0.024" >&2
